<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/nav_activation"
            android:textAllCaps="true"
            android:textColor="@color/neon"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtActStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:textColor="@color/cyan"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/overlay_perm_title"
                android:textAllCaps="true"
                android:textColor="@color/neon"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/overlay_perm_body"
                android:textColor="@color/text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/overlay_perm_btn"
                app:cornerRadius="4dp"
                app:icon="@drawable/ic_stretch"
                app:iconGravity="textStart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/shizuku_title"
                android:textAllCaps="true"
                android:textColor="@color/neon"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/shizuku_status_off"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/shizuku_body"
                android:textColor="@color/text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShizukuAuth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/authorize"
                app:cornerRadius="4dp"
                app:icon="@drawable/ic_key"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenShizuku"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/open_shizuku"
                app:cornerRadius="4dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:strokeColor="@color/neon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDevOptions"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_dev" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
