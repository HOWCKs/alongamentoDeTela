<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_bubble"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <ImageView
            android:id="@+id/imgBubble"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_stretch" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:text="@string/overlay_title"
                android:textAllCaps="true"
                android:textColor="@color/neon"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMinimize"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/overlay_minimize"
                android:padding="10dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1.10x"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sliderMult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="10"
            android:progressTint="@color/neon"
            android:thumbTint="@color/neon" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_native"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtNative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_proj"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtProj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cyan"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModeAlongar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_outline"
                android:text="@string/mode_alongar"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnModeCorte"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_fill"
                android:text="@string/mode_corte"
                android:textAllCaps="true"
                android:textColor="@color/on_neon"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_fill"
                android:text="@string/apply_short"
                android:textAllCaps="true"
                android:textColor="@color/on_neon"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_outline"
                android:text="@string/restore"
                android:textAllCaps="true"
                android:textColor="@color/text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
